{
  "name": "@escapace/fsm",
  "description": "Flat extended finite state machines in TypeScript with a typed builder, declaration-order transition selection, and isolated drafts for speculative txecution.",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/fsm/issues",
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@escapace/pnpm-pack": "0.9.2",
    "@escapace/syncpack-configuration": "0.3.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@vitest/coverage-v8": "4.1.11",
    "alien-deepsignals": "0.4.3",
    "eslint": "10.8.1",
    "eslint-config-escapace": "5.20.3",
    "esroll": "1.3.1",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "15.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vue": "3.5.41",
    "xstate": "5.32.5",
    "yay-machine": "1.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn",
      "version": "^10.33.0"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/neutral/index.js"
    }
  },
  "files": [
    "lib/neutral",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/fsm#readme",
  "license": "MPL-2.0",
  "module": "lib/neutral/index.js",
  "peerDependencies": {
    "@escapace/reconcile": "^0.2.0",
    "@escapace/typelevel": "^2.0.5",
    "coastal": "^0.4.0",
    "es-toolkit": "^1.51.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/fsm",
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsx scripts/build.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "lib/types/index.d.ts"
}
