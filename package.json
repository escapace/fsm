  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@escapace/pnpm-pack": "0.6.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/lodash-es": "4.17.12",
    "@vitest/coverage-v8": "3.2.4",
    "@xstate/fsm": "2.1.0",
    "eslint": "9.33.0",
    "eslint-config-escapace": "5.9.0",
    "esroll": "0.4.5",
    "knip": "5.63.0",
    "lefthook": "1.12.3",
    "lodash-es": "4.17.21",
    "prettier": "3.6.2",
    "prettier-config-escapace": "1.2.1",
    "simple-statistics": "7.8.8",
    "syncpack": "13.0.4",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "pnpm": "^10.14.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/neutral/index.js"
    }
  },
  "files": [
    "lib/neutral",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/fsm#readme",
  "license": "MPL-2.0",
  "module": "lib/neutral/index.js",
  "peerDependencies": {
    "@escapace/typelevel": "^2.0.2",
    "coastal": "^0.2.1"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/fsm",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix-mismatches && syncpack set-semver-ranges && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "lib/types/index.d.ts"
}
